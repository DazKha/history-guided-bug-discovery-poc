            def f():
                value = "caf\u00e9"
                return value

            f()

            with open(out_path, "r", encoding="utf-8") as fh:
                content = fh.read()

            assert "caf\u00e9" in content, (
                "Non-ASCII value missing from trace file. Content: %r" % content
            )
            print("OK")
